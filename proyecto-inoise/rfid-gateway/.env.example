# URL del backend en la nube (Railway). Dejar vacío para correr el gateway
# solo en modo local (sin reenvío en vivo a otras PCs).
CLOUD_URL=https://proyecto-bodega-antenas-production.up.railway.app

# Secreto compartido con el backend en la nube — debe ser EXACTAMENTE el
# mismo valor que la variable GATEWAY_TOKEN en Railway (Variables del
# servicio cloud-backend). Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_TOKEN=cambiar-por-un-secreto-largo-y-aleatorio
