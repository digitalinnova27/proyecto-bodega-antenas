# Copiar a .env (nunca commitear .env real) y completar con los valores reales.

# Supabase → Project Settings → Database → Connection string → Direct connection (URI)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres"

# Secreto para firmar los JWT de sesión — generar uno random (no reusar el
# de la app de Electron). Ej: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Puerto en el que escucha el servidor Express
PORT=3005
